# Python 虚拟环境
.venv/

# 环境变量 (含 API Key)
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 输出文件（生成的结果、简历、报告等）
output/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# SQLite 运行时数据库（种子数据通过 data/migrate.py 初始化）
data/job_agent.db

# 用户标记文件（已迁移到 SQLite）
profiles/.current_user

# 系统文件
.DS_Store
Thumbs.db
*.tmp
*.bak
*.log
